---
import ButtonCopy from '@components/common/ButtonCopy.astro';
import SectionHeader from '@components/common/SectionHeader.astro';
import { contactData as enContact } from '@content/data/en';
import { contactData as esContact } from '@content/data/es';
import { type Locale, useTranslations } from '@i18n/utils';
import { Icon } from 'astro-icon/components';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang, 'contact');
const contact = lang === 'es' ? esContact : enContact;
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <SectionHeader
    prefix="0x06"
    title={t('heading')}
    subtitle={t('subtitle')}
    id="contact-heading"
  />

  <div class="contact-group">
    <h3 class="contact-group-label">{t('emailHeading')}</h3>
    <div class="contact-actions">
      <ButtonCopy
        id="copy-email-btn"
        class="contact-copy-btn"
        data={contact.email}
        prefixIcon="mail"
        ariaLabel={t('copyEmailAria')}
      />

      <a
        target="_blank"
        href={`mailto:${contact.email}`}
        class="btn-cad btn-mailto"
        aria-label={t('mailtoAria')}
      >
        <span class="icon-wrap" aria-hidden="true">
          <Icon name="messages" size={20} class="icon-send" />
        </span>
        <span class="mailto-label">{t('mailtoLabel')}</span>
      </a>
    </div>
  </div>

  <div class="contact-group">
    <h3 class="contact-group-label">{t('socialsHeading')}</h3>
    <nav class="contact-socials" aria-label={t('socialsAria')}>
      <ul class="socials-list">
        {
          contact.socials.map((social) => (
            <li class="social-item">
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="social-card cad-frame"
                aria-label={`${social.name} (${social.handle})`}
              >
                <div class="social-header">
                  <div class="social-platform">
                    <span class="social-icon-frame" aria-hidden="true">
                      <Icon
                        name={social.icon ?? social.name.toLowerCase()}
                        size={18}
                        class="icon-social"
                      />
                    </span>
                    <span class="social-name">{social.name}</span>
                  </div>
                  <span class="social-arrow" aria-hidden="true">
                    ↗
                  </span>
                </div>
                <span class="social-handle">{social.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="contact-group">
    <h3 class="contact-group-label">{t('resumeHeading')}</h3>
    <div class="resume-actions">
      <a
        href={contact.resume.url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-cad btn-secondary resume-view-btn"
        aria-label={t('resumeViewAria')}
      >
        <span class="icon-wrap" aria-hidden="true">
          <Icon name="file-text" size={18} class="icon-file" />
        </span>
        <span class="resume-label">{contact.resume.label}</span>
        <span class="resume-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        href={contact.resume.url}
        download={contact.resume.downloadName}
        class="btn-cad btn-secondary resume-download-btn"
        aria-label={t('resumeDownloadAria')}
        title={t('resumeDownloadAria')}
      >
        <span class="icon-wrap" aria-hidden="true">
          <Icon name="download" size={18} class="icon-download" />
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .contact-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-group-label {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono-console);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
    color: var(--colors-on-surface-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }

  .contact-actions {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 16px;
  }

  .contact-copy-btn {
    flex: 1 1 340px;
  }

  .icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .btn-mailto {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
  }

  .contact-socials {
    width: 100%;
  }

  .socials-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .socials-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .social-item {
    list-style: none;
    display: flex;
  }

  .social-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    background-color: var(--colors-surface);
    text-decoration: none;
    transition:
      background-color var(--transition-micro),
      outline var(--transition-micro),
      outline-offset var(--transition-micro);
  }

  .social-card:hover {
    outline: 2px dashed var(--colors-punctual);
    outline-offset: 2px;
    background-color: var(--colors-surface-elevated);
  }

  .social-card:hover .social-icon-frame {
    border-color: var(--colors-punctual);
    color: var(--colors-punctual);
  }

  .social-card:hover .social-arrow {
    transform: translate(2px, -2px);
    color: var(--colors-punctual);
  }

  .social-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .social-platform {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .social-icon-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    background-color: var(--colors-surface-dim);
    border: 1px solid var(--colors-outline-subtle);
    color: var(--colors-primary);
    transition:
      border-color var(--transition-micro),
      color var(--transition-micro);
  }

  .icon-social {
    width: 18px;
    height: 18px;
  }

  .social-name {
    font-family: var(--font-mono-display);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--colors-on-background);
  }

  .social-arrow {
    font-family: var(--font-mono-console);
    font-size: 1.1rem;
    color: var(--colors-primary-light);
    transition:
      transform var(--transition-micro),
      color var(--transition-micro);
  }

  .social-handle {
    font-family: var(--font-mono-console);
    font-size: var(--font-size-caption);
    color: var(--colors-on-surface-muted);
    letter-spacing: 0.03em;
    word-break: break-all;
  }

  .resume-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .resume-view-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    font-size: var(--font-size-body-sm);
    text-decoration: none;
    width: fit-content;
  }

  .resume-view-btn:hover .resume-arrow {
    transform: translate(2px, -2px);
    color: var(--colors-punctual);
  }

  .resume-download-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    flex-shrink: 0;
    text-decoration: none;
  }

  .resume-arrow {
    font-family: var(--font-mono-console);
    font-size: 1.1rem;
    color: var(--colors-primary-light);
    margin-left: 2px;
    transition:
      transform var(--transition-micro),
      color var(--transition-micro);
  }

  .icon-file {
    color: var(--colors-primary-light);
  }

  .icon-download {
    color: var(--colors-on-surface);
  }

  @media (max-width: 640px) {
    .contact-actions {
      flex-direction: column;
    }

    .contact-copy-btn {
      width: 100%;
      flex: 1 1 auto;
    }

    .btn-mailto {
      width: 100%;
      justify-content: center;
    }

    .resume-actions {
      width: 100%;
    }

    .resume-view-btn {
      flex: 1 1 auto;
      justify-content: center;
    }

    .resume-download-btn {
      flex: 0 0 44px;
    }
  }
</style>
