---
import SectionHeader from '@components/common/SectionHeader.astro';
import SkillCard from '@components/common/SkillCard.astro';
import { skillsData as enSkills } from '@content/data/en';
import { skillsData as esSkills } from '@content/data/es';
import { type Locale, useTranslations } from '@i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang, 'skills');
const skills = lang === 'es' ? esSkills : enSkills;
---

<section id="skills" class="skills-section" aria-labelledby="skills-heading">
    <SectionHeader
        prefix="0x04"
        title={t("heading")}
        subtitle={t("subtitle")}
        id="skills-heading"
    />
    <div class="skills-grid">
        {skills.map((skill) => (
            <SkillCard skill={skill} />
        ))}
    </div>
</section>

<style>
    .skills-section {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
    }

    @media (min-width: 768px) {
        .skills-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
