---
import { getCollection } from 'astro:content';
import PillStack from '@components/common/PillStack.astro';
import SectionHeader from '@components/common/SectionHeader.astro';
import { type Locale, useTranslations } from '@i18n/utils';
import { Icon } from 'astro-icon/components';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang, 'projects');

const rawProjects = await getCollection('projects', ({ id }) =>
  id.startsWith(`${lang}/`),
);

const projects = rawProjects.sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
---

<section
    id="projects"
    class="projects-section"
    aria-labelledby="projects-heading"
>
    <SectionHeader
        prefix="0x03"
        title={t("heading")}
        subtitle={t("subtitle")}
        id="projects-heading"
    />

    <div
        class="projects-explorer"
        data-projects-explorer
        data-mobile-view="list"
    >
        {/* Left Column: Master Project List */}
        <aside class="projects-master" aria-label={t("listAriaLabel")}>
            <ul class="projects-list" role="tablist">
                {projects.map((project, index) => {
                    const num = String(index + 1).padStart(2, "0");
                    const isSelected = index === 0;
                    return (
                        <li class="project-list-item" role="presentation">
                            <button
                                type="button"
                                role="tab"
                                id={`project-tab-${index}`}
                                aria-selected={isSelected ? "true" : "false"}
                                aria-controls={`project-panel-${index}`}
                                tabindex={isSelected ? 0 : -1}
                                class:list={[
                                    "project-trigger",
                                    "cad-frame",
                                    { "is-active": isSelected },
                                ]}
                                data-project-trigger={index}
                            >
                                <span class="project-num">{num}</span>
                                <div class="project-summary-info">
                                    <h3 class="project-summary-title">
                                        {project.data.title}
                                    </h3>
                                    <p class="project-summary-sub">
                                        {project.data.subtitle}
                                    </p>
                                </div>
                            </button>
                        </li>
                    );
                })}
            </ul>
        </aside>

        {/* Right Column: Project Overview Inspector */}
        <div class="projects-detail">
            {/* Overview Panels (Master-Detail target) */}
            <div class="projects-panels">
                {projects.map((project, index) => {
                    const isSelected = index === 0;
                    return (
                        <article
                            role="tabpanel"
                            id={`project-panel-${index}`}
                            aria-labelledby={`project-tab-${index}`}
                            class="project-panel cad-frame"
                            data-project-panel={index}
                            hidden={!isSelected}
                        >
                            {/* Blueprint / Schematic Media Banner */}
                            <figure class="panel-banner">
                                <div
                                    class="panel-blueprint-grid"
                                    aria-hidden="true"
                                >
                                    <figcaption class="panel-fig-caption">
                                        ARCH_SCHEMATIC
                                    </figcaption>
                                    <span class="blueprint-coords">
                                        X:{120 + index * 30} Y:
                                        {450 - index * 20}
                                    </span>
                                </div>
                                {project.data.image && (
                                    <div class="panel-media">
                                        <img
                                            src={project.data.image}
                                            alt={
                                                project.data.imageAlt ??
                                                `${project.data.title} preview`
                                            }
                                            class="panel-img"
                                            loading={index === 0 ? "eager" : "lazy"}
                                            decoding="async"
                                        />
                                    </div>
                                )}
                                {project.data.achievement && (
                                    <div class="panel-achievement-badge">
                                        <span
                                            class="achievement-star"
                                            aria-hidden="true"
                                        >
                                            ★
                                        </span>
                                        <span class="achievement-text">
                                            {project.data.achievement}
                                        </span>
                                    </div>
                                )}
                            </figure>

                            {/* Panel Header */}
                            <header class="panel-header separator">
                                <div class="panel-title-group">
                                    <h3 class="panel-title">
                                        {project.data.title}
                                    </h3>
                                    <p class="panel-subtitle">
                                        {project.data.subtitle}
                                    </p>
                                </div>

                                <nav
                                    class="panel-actions"
                                    aria-label={t("aria")}
                                >
                                    <ul class="actions-list">
                                        {project.data.repoUrl && (
                                            <li>
                                                <a
                                                    class="btn-cad btn-secondary"
                                                    href={project.data.repoUrl}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                >
                                                    {t("sourceCode")}
                                                </a>
                                            </li>
                                        )}
                                        {project.data.demoUrl && (
                                            <li>
                                                <a
                                                    class="btn-cad"
                                                    href={project.data.demoUrl}
                                                >
                                                    {t("liveDemo")}
                                                </a>
                                            </li>
                                        )}
                                    </ul>
                                </nav>
                            </header>

                            {/* Description */}
                            <p class="panel-desc">{project.data.description}</p>

                            {/* Key Highlights */}
                            {project.data.highlights.length > 0 && (
                                <ul class="project-highlights">
                                    {project.data.highlights.map(
                                        (highlight) => (
                                            <li class="highlight-item">
                                                {highlight}
                                            </li>
                                        ),
                                    )}
                                </ul>
                            )}

                            {/* Tech Stack Footer */}
                            <PillStack
                                primaryTech={project.data.primaryTech}
                                secondaryTech={project.data.secondaryTech}
                                ariaLabel={`${project.data.title} tech stack`}
                            />
                        </article>
                    );
                })}
            </div>

            {/* Mobile Navigation Controls - Placed below panels */}
            <div
                class="mobile-nav-bar cad-frame"
                aria-label="Mobile project navigation"
            >
                <button
                    type="button"
                    class="btn-cad btn-secondary btn-mobile-nav"
                    data-project-back
                    aria-label={t("backToList")}
                >
                    <span aria-hidden="true">←</span>
                    <span>{t("backToList")}</span>
                </button>
                <div class="mobile-nav-controls">
                    <span
                        class="project-counter"
                        data-project-counter
                        aria-live="polite"
                    >
                        01 / {String(projects.length).padStart(2, "0")}
                    </span>
                    <button
                        type="button"
                        class="btn-cad btn-secondary btn-nav-step"
                        data-project-prev
                        aria-label={t("prevProject")}
                    >
                        <Icon
                            name="arrow-badge-left"
                            class="nav-step-icon"
                            aria-hidden="true"
                        />
                    </button>
                    <button
                        type="button"
                        class="btn-cad btn-secondary btn-nav-step"
                        data-project-next
                        aria-label={t("nextProject")}
                    >
                        <Icon
                            name="arrow-badge-right"
                            class="nav-step-icon"
                            aria-hidden="true"
                        />
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import "@/scripts/projectsExplorer";
</script>

<style>
    .projects-section {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .projects-explorer {
        display: grid;
        grid-template-columns: minmax(280px, 350px) 1fr;
        gap: 24px;
        align-items: start;
    }

    /* Master List */
    .projects-master {
        width: 100%;
    }

    .projects-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .project-list-item {
        display: flex;
    }

    .project-trigger {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        background-color: var(--colors-surface);
        border: 1px solid var(--colors-outline-subtle);
        color: var(--colors-on-surface);
        text-align: left;
        cursor: pointer;
        border-radius: 0;
        font-family: inherit;
        outline-offset: 6px;
        transition:
            background-color var(--transition-micro),
            color var(--transition-micro),
            transform 1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .project-trigger:hover {
        background-color: var(--colors-surface-elevated);
        outline: 2px dashed var(--colors-punctual);
        outline-offset: 2px;
    }

    .project-trigger.is-active,
    .project-trigger[aria-selected="true"] {
        background-color: var(--colors-surface-elevated);
        outline: 2px dashed var(--colors-primary);
        outline-offset: 2px;

        &:hover {
            background-color: var(--colors-surface-elevated);
            outline: 2px dashed var(--colors-punctual);
            outline-offset: 2px;
        }
    }

    .project-num {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        font-weight: var(--font-weight-semibold);
        color: var(--colors-primary-light);
        opacity: 0.85;
        letter-spacing: 0.05em;
        user-select: none;
    }

    :global(:root[data-theme="bee"]) .project-num {
        color: var(--colors-primary);
    }

    .project-summary-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .project-summary-title {
        font-size: var(--font-size-body-md);
        font-weight: var(--font-weight-semibold);
        margin: 0;
        color: var(--colors-on-surface);
        line-height: 1.3;
        overflow-wrap: break-word;
    }

    .project-summary-sub {
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
        margin: 0;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Detail / Inspector Column */
    .projects-detail {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-width: 0;
    }

    /* Mobile Nav Bar - Hidden by default on desktop/tablet */
    .mobile-nav-bar {
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 10px 14px;
        background-color: var(--colors-surface-dim);
        border: 1px solid var(--colors-outline-subtle);
    }

    .btn-mobile-nav {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        min-height: 36px;
        font-size: var(--font-size-caption);
    }

    .mobile-nav-controls {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .project-counter {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
        letter-spacing: 0.05em;
    }

    .btn-nav-step {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        padding: 0;
        line-height: 1;
        aspect-ratio: 1/1;
    }

    .nav-step-icon {
        width: 20px;
        height: 20px;
        display: block;
    }

    /* Project Panel */
    .project-panel {
        padding: clamp(20px, 3.5vw, 32px);
        display: flex;
        flex-direction: column;
        gap: 20px;
        border-radius: 0;
    }

    .project-panel[hidden] {
        display: none !important;
    }

    /* Technical Blueprint Banner */
    .panel-banner {
        position: relative;
        min-height: 120px;
        margin: 0;
        background-color: var(--colors-surface-dim);
        border: 1px solid var(--colors-outline-subtle);
        background-image:
            linear-gradient(var(--grid-dot-color) 1px, transparent 1px),
            linear-gradient(
                to right,
                var(--grid-dot-color) 1px,
                transparent 1px
            );
        background-size: 24px 24px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 14px 16px;
        overflow: hidden;
        counter-increment: figure-counter;
    }

    .panel-blueprint-grid {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
        opacity: 0.75;
        letter-spacing: 0.06em;
    }

    .panel-fig-caption {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
        letter-spacing: 0.06em;
        line-height: 1.3;
        user-select: none;
    }

    .panel-fig-caption::before {
        content: "Fig. " counter(figure-counter) ": ";
        font-weight: var(--font-weight-semibold);
        color: var(--colors-primary-light);
    }

    :global(:root[data-theme="bee"]) .panel-fig-caption::before {
        color: var(--colors-primary);
    }

    .panel-media {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-height: 240px;
        background-color: var(--colors-surface);
        border: 1px solid var(--colors-outline-subtle);
        overflow: hidden;
    }

    .panel-img {
        width: 100%;
        height: auto;
        max-height: 240px;
        object-fit: contain;
        display: block;
    }

    .panel-achievement-badge {
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background-color: color-mix(
            in srgb,
            var(--colors-punctual) 14%,
            var(--colors-surface)
        );
        border: 1px solid var(--colors-punctual);
        color: var(--colors-on-surface);
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        font-weight: var(--font-weight-medium);
        letter-spacing: 0.03em;
        line-height: 1.3;
    }

    .achievement-star {
        color: var(--colors-punctual);
        font-size: 0.95rem;
    }

    /* Panel Header */
    .panel-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        padding-bottom: 14px;
    }

    .panel-title-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .panel-title {
        font-size: var(--font-size-h3);
        font-weight: var(--font-weight-semibold);
        color: var(--colors-on-surface);
        margin: 0;
        line-height: 1.25;
    }

    .panel-subtitle {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
        margin: 0;
    }

    .actions-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .panel-desc {
        font-size: var(--font-size-body-sm);
        line-height: 1.6;
        color: var(--colors-on-surface);
        margin: 0;
    }

    /* Key Highlights / Bullets */
    .project-highlights {
        list-style: none;
        padding: 0;
        margin: 0;
        margin-left: clamp(16px, 3vw, 36px);
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .highlight-item {
        position: relative;
        padding-left: 18px;
        font-size: var(--font-size-body-sm);
        line-height: 1.6;
        color: var(--colors-on-surface-muted);
    }

    /* Default theme marker: crisp square (zero border-radius) */
    .highlight-item::before {
        content: "";
        position: absolute;
        left: 2px;
        top: 0.6em;
        width: 5px;
        height: 5px;
        background-color: var(--colors-primary-light);
        border-radius: 0;
        transform: translateY(-50%);
        pointer-events: none;
    }

    /* Bee theme marker: rotating pentagon ("panal" dot) calculated via sibling-index() */
    :global(:root[data-theme="bee"]) .highlight-item {
        --item-index: sibling-index();

        &::before {
            left: 1px;
            width: 8px;
            height: 8px;
            background-color: var(--colors-primary);
            clip-path: polygon(50% 0%, 100% 38%, 81% 100%, 19% 100%, 0% 38%);
            border-radius: 0;
            --pentagon-rot: calc(var(--item-index, 0) * 25deg);
            transform: translateY(-50%) rotate(var(--pentagon-rot));
        }
    }

    /* Mobile Responsive Drill-Down */
    @media (max-width: 768px) {
        .projects-explorer {
            grid-template-columns: 1fr;
        }

        .mobile-nav-bar {
            display: flex;
        }

        /* When viewing list on mobile, hide the detail container */
        .projects-explorer[data-mobile-view="list"] .projects-detail {
            display: none;
        }

        /* When viewing detail on mobile, hide the master list */
        .projects-explorer[data-mobile-view="detail"] .projects-master {
            display: none;
        }

        .project-highlights {
            margin-left: 0;
        }
    }
</style>
