---
import ExperienceCard from '@components/common/ExperienceCard.astro';
import SectionHeader from '@components/common/SectionHeader.astro';
import { experienceRoles as enRoles } from '@content/data/en';
import { experienceRoles as esRoles } from '@content/data/es';
import { type Locale, useTranslations } from '@i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang, 'experience');
const roles = lang === 'es' ? esRoles : enRoles;
---

<section
    id="experience"
    class="experience-section"
    aria-labelledby="experience-heading"
>
    <SectionHeader
        prefix="0x02"
        title={t("heading")}
        subtitle={t("subtitle")}
        id="experience-heading"
    />
    <ol class="timeline-list">
        {roles.map((role) => (
            <li class="timeline-item">
                <ExperienceCard
                    role={role}
                    presentLabel={t("present")}
                    stackLabel={t("stack")}
                    lang={lang}
                />
            </li>
        ))}
    </ol>
</section>

<style>
    .experience-section {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .timeline-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
</style>
