---
import { Image } from 'astro:assets';
import { type Locale, useTranslations } from '@i18n/utils';
import { Icon } from 'astro-icon/components';
import heroPortrait from '@/assets/hero-portrait.webp';

interface Props {
  lang: Locale;
}

const HERO_INFO_LABELS = Object.freeze([
  'role',
  'stack',
  'knowledge',
  'timezone',
] as const);

const { lang } = Astro.props;
const t = useTranslations(lang, 'hero');

const lastNameChars = t('lastName').split('');
---

<section
    id="hero"
    class="hero-section hero-console"
    aria-labelledby="hero-heading"
>
    <div class="hero-grid">
        <div class="hero-content">
            <h1 id="hero-heading" class="hero-name">
                <span class="first-name">{t("title")}</span>
                <span class="last-name">
                    <span class="sr-only">{t("lastName")}</span>
                    <span aria-hidden="true" class="last-name-chars">
                        {lastNameChars.map((char) => (
                            <span>{char}</span>
                        ))}
                    </span>
                </span>
            </h1>

            <dl class="hero-info-list cad-frame">
                {HERO_INFO_LABELS.map((item) => (
                    <div class="hero-info-item">
                        <dt class="hero-info-label">{t(`${item}.label`)}</dt>
                        <dd class="hero-info-value">{t(`${item}.value`)}</dd>
                    </div>
                ))}
            </dl>

            <nav class="hero-actions" aria-label={t("actions.aria")}>
                <ul>
                    <li>
                        <a class="btn-cad btn-secondary" href="#experience">
                            {t("cta.exp")}
                        </a>
                    </li>
                    <li>
                        <a class="btn-cad" href="#contact">
                            {t("cta.contact")}
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <div class="hero-media">
            <figure class="hero-portrait cad-frame">
                <Image
                    src={heroPortrait}
                    alt={t("photo.alt")}
                    width={480}
                    height={480}
                    widths={[240, 360, 480, 720, 960]}
                    sizes="(max-width: 640px) 100vw, 480px"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    class="hero-img"
                />
                <figcaption class="hero-photo-caption">
                    {t("photo.caption")}
                </figcaption>
            </figure>

            <aside class="hero-separator" aria-label={t("highlights.aria")}>
                <div class="separator-item">
                    <span class="separator-val">8.22</span>
                    <span class="separator-label">{t("metric.gpa.label")}</span>
                </div>

                <div class="separator-item">
                    <span class="separator-val">B2</span>
                    <span class="separator-label">
                        {t("metric.english.label")}
                    </span>
                </div>

                <div class="separator-item">
                    <span class="separator-val icon-val" aria-hidden="true">
                        <Icon name="mug" size={32} class="icon-coffee" />
                    </span>
                    <span class="separator-label">
                        {t("metric.coffee.label")}
                    </span>
                </div>
            </aside>
        </div>
    </div>
</section>

<style>
    .hero-section {
        padding-block: clamp(16px, 4vw, 36px);
    }

    .hero-grid {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    @media (min-width: 860px) {
        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
            grid-template-areas:
                "content portrait"
                "separator separator";
            gap: 36px 48px;
            align-items: center;
        }
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    @media (min-width: 860px) {
        .hero-content {
            grid-area: content;
        }
    }

    .hero-name {
        display: inline-flex;
        flex-direction: column;
        width: fit-content;
        max-width: 100%;
        margin: 0;
        line-height: 1;
        gap: 6px;
    }

    .first-name {
        font-family: var(--font-mono-display);
        font-size: clamp(3.5rem, 10.5vw, 6.25rem);
        font-weight: var(--font-weight-black);
        line-height: 0.92;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--colors-on-background);
        white-space: nowrap;
    }

    .last-name {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        width: 100%;
        font-family: var(--font-mono-display);
        font-size: clamp(1.5rem, 4.6vw, 2.75rem);
        font-weight: var(--font-weight-regular);
        line-height: 1.15;
        color: var(--colors-on-surface-muted);
        user-select: none;
        white-space: nowrap;
    }

    .last-name-chars {
        display: flex;
        justify-content: space-between;
        width: 100%;
        text-transform: uppercase;
    }

    .hero-info-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin: 0;
        padding: 18px 20px;
        background-color: var(--colors-surface);
        border: 1px solid var(--colors-outline-subtle);
    }

    @media (min-width: 580px) {
        .hero-info-list {
            grid-template-columns: repeat(2, 1fr);
            gap: 16px 24px;
        }
    }

    .hero-info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .hero-info-label {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        font-weight: var(--font-weight-medium);
        color: var(--colors-on-surface-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .hero-info-value {
        margin: 0;
        font-family: var(--font-mono-body);
        font-size: var(--font-size-body-sm);
        color: var(--colors-on-surface);
        font-weight: var(--font-weight-medium);
        line-height: 1.45;
    }

    .hero-actions ul {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .hero-media {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        justify-content: center;
        gap: clamp(16px, 4vw, 28px);
        width: fit-content;
        max-width: 100%;
        margin-inline: auto;
    }

    @media (min-width: 860px) {
        .hero-media {
            display: contents;
        }
    }

    .hero-portrait {
        margin: 0;
        padding: 8px 8px 10px;
        background-color: var(--colors-surface);
        border: 1px solid var(--colors-outline-subtle);
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-width: 320px;
        width: 100%;
        counter-increment: figure-counter;
        flex: 1 1 auto;
    }

    @media (min-width: 860px) {
        .hero-portrait {
            grid-area: portrait;
            max-width: 380px;
            margin-inline: auto;
        }
    }

    .hero-picture {
        display: block;
        width: 100%;
        height: auto;
    }

    .hero-img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border: 1px solid var(--colors-outline-subtle);
    }

    .hero-photo-caption {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
        text-align: center;
        letter-spacing: 0.05em;
        line-height: 1.3;
        user-select: none;
    }

    .hero-photo-caption::before {
        content: "Fig. " counter(figure-counter) ": ";
        font-weight: var(--font-weight-semibold);
        color: var(--colors-primary-light);
    }

    .hero-separator {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 8px 4px;
        margin: 0;
        box-shadow: none;
        flex: 0 0 auto;
    }

    @media (min-width: 860px) {
        .hero-separator {
            grid-area: separator;
            flex-direction: row;
            justify-content: center;
            gap: clamp(24px, 6vw, 56px);
            padding: 20px 24px;
        }
    }

    .separator-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 4px;
    }

    @media (min-width: 860px) {
        .separator-item {
            gap: 6px;
        }
    }

    .separator-val {
        font-family: var(--font-mono-display);
        font-size: clamp(1.5rem, 3.5vw, 2.35rem);
        font-weight: var(--font-weight-black);
        color: var(--colors-primary-light);
        line-height: 1;
    }

    .separator-val.icon-val {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: clamp(1.5rem, 3.5vw, 2.35rem);
        color: var(--colors-primary-light);
    }

    .icon-coffee {
        width: 28px;
        height: 28px;
        display: block;
    }

    @media (min-width: 860px) {
        .icon-coffee {
            width: 32px;
            height: 32px;
        }
    }

    .separator-label {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        line-height: 1.25;
        text-align: center;
        max-width: 90px;
    }

    @media (min-width: 860px) {
        .separator-label {
            max-width: none;
            line-height: 1.3;
        }
    }
</style>
