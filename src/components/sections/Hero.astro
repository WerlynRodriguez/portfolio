---
import { type Locale, useTranslations } from '@i18n/utils';
import { Icon } from 'astro-icon/components';
import heroPortrait from '@/assets/hero-portrait.webp';

interface Props {
  lang: Locale;
}

const HERO_INFO_LABELS = Object.freeze([
  'role',
  'stack',
  'knowledge',
  'timezone',
] as const);

const { lang } = Astro.props;
const t = useTranslations(lang, 'hero');

const lastNameChars = t('lastName').split('');
---

<section
    id="hero"
    class="hero-section hero-console"
    aria-labelledby="hero-heading"
>
    <div class="hero-grid">
        <div class="hero-content">
            <h1 id="hero-heading" class="hero-name">
                <span class="first-name">{t("title")}</span>
                <span class="last-name" aria-label={t("lastName")}>
                    {lastNameChars.map((char) => (
                        <span aria-hidden="true">{char}</span>
                    ))}
                </span>
            </h1>

            <dl class="hero-info-list cad-frame">
                {HERO_INFO_LABELS.map((item) => (
                    <div class="hero-info-item">
                        <dt class="hero-info-label">{t(`${item}.label`)}</dt>
                        <dd class="hero-info-value">{t(`${item}.value`)}</dd>
                    </div>
                ))}
            </dl>

            <nav class="hero-actions" aria-label={t("actions.aria")}>
                <ul>
                    <li>
                        <a class="btn-cad btn-secondary" href="#projects">
                            {t("cta.projects")}
                        </a>
                    </li>
                    <li>
                        <a class="btn-cad" href="#contact">
                            {t("cta.contact")}
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <figure class="hero-portrait cad-frame">
            <picture class="hero-picture">
                <source srcset={heroPortrait.src} type="image/webp" />
                <img
                    src={heroPortrait.src}
                    alt={t("photo.alt")}
                    width="480"
                    height="480"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    class="hero-img"
                />
            </picture>
            <figcaption class="hero-photo-caption">
                {t("photo.caption")}
            </figcaption>
        </figure>
    </div>

    <aside class="hero-separator separator-dashed" aria-label="Highlights">
        <div class="separator-item">
            <span class="separator-val">8.22</span>
            <span class="separator-label">{t("metric.gpa.label")}</span>
        </div>

        <div class="separator-item">
            <span class="separator-val">B2</span>
            <span class="separator-label">{t("metric.english.label")}</span>
        </div>

        <div class="separator-item">
            <span class="separator-val icon-val" aria-hidden="true">
                <Icon name="mug" size={32} class="icon-coffee" />
            </span>
            <span class="separator-label">{t("metric.coffee.label")}</span>
        </div>
    </aside>
</section>

<style>
    .hero-section {
        padding-block: clamp(16px, 4vw, 36px);
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
        align-items: center;
    }

    @media (min-width: 860px) {
        .hero-grid {
            grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
            gap: 48px;
        }
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .hero-name {
        display: inline-flex;
        flex-direction: column;
        width: fit-content;
        max-width: 100%;
        margin: 0;
        line-height: 1;
        gap: 6px;
    }

    .first-name {
        font-family: var(--font-mono-display);
        font-size: clamp(3.5rem, 10.5vw, 6.25rem);
        font-weight: var(--font-weight-black);
        line-height: 0.92;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: var(--colors-on-background);
        white-space: nowrap;
    }

    .last-name {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        width: 100%;
        font-family: var(--font-mono-display);
        font-size: clamp(1.5rem, 4.6vw, 2.75rem);
        font-weight: var(--font-weight-regular);
        line-height: 1.15;
        color: var(--colors-on-surface-muted);
        user-select: none;
        white-space: nowrap;
    }

    .hero-info-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin: 0;
        padding: 18px 20px;
        background-color: var(--colors-surface);
        border: 1px solid var(--colors-outline-subtle);
    }

    @media (min-width: 580px) {
        .hero-info-list {
            grid-template-columns: repeat(2, 1fr);
            gap: 16px 24px;
        }
    }

    .hero-info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .hero-info-label {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        font-weight: var(--font-weight-medium);
        color: var(--colors-on-surface-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .hero-info-value {
        margin: 0;
        font-family: var(--font-mono-body);
        font-size: var(--font-size-body-sm);
        color: var(--colors-on-surface);
        font-weight: var(--font-weight-medium);
        line-height: 1.45;
    }

    .hero-actions ul {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .hero-portrait {
        margin: 0;
        padding: 8px 8px 10px;
        background-color: var(--colors-surface);
        border: 1px solid var(--colors-outline-subtle);
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-width: 380px;
        width: 100%;
        margin-inline: auto;
        counter-increment: figure-counter;
    }

    .hero-picture {
        display: block;
        width: 100%;
        height: auto;
    }

    .hero-img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border: 1px solid var(--colors-outline-subtle);
    }

    .hero-photo-caption {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
        text-align: center;
        letter-spacing: 0.05em;
        line-height: 1.3;
        user-select: none;
    }

    .hero-photo-caption::before {
        content: "Fig. " counter(figure-counter) ": ";
        font-weight: var(--font-weight-semibold);
        color: var(--colors-primary-light);
    }

    .hero-separator {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: clamp(24px, 6vw, 56px);
        padding: 20px 24px;
        margin-top: clamp(24px, 4vw, 36px);
        box-shadow: none;
    }

    .separator-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 6px;
    }

    .separator-val {
        font-family: var(--font-mono-display);
        font-size: clamp(1.75rem, 3.5vw, 2.35rem);
        font-weight: var(--font-weight-black);
        color: var(--colors-primary-light);
        line-height: 1;
    }

    .separator-val.icon-val {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: clamp(1.75rem, 3.5vw, 2.35rem);
        color: var(--colors-primary-light);
    }

    .icon-coffee {
        width: 32px;
        height: 32px;
        display: block;
    }

    .separator-label {
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        line-height: 1.3;
        text-align: center;
    }

    @media (max-width: 639px) {
        .hero-separator {
            gap: 20px;
            padding: 16px 20px;
        }
    }
</style>
