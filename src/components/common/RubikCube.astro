---
import RubikBaseLayer from '@components/common/rubik/RubikBaseLayer.astro';
import RubikDialLayer from '@components/common/rubik/RubikDialLayer.astro';
import RubikLowerLayer from '@components/common/rubik/RubikLowerLayer.astro';
import RubikTopLayer from '@components/common/rubik/RubikTopLayer.astro';
import { type Locale, useTranslations } from '@i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang, 'overview');
---

<figure class="iso rubik-figure cad-frame" data-rubik-figure>
    <div class="iso-plate">
        <div class="iso-plate-corners" aria-hidden="true">
            <span class="iso-plate-corner" data-corner="fig"></span>
            <span class="iso-plate-corner" data-corner="title">
                {t("rubik.title")}
            </span>
            <span class="iso-plate-corner" data-corner="hint">
                {t("rubik.hint")}
            </span>
            <output
                class="iso-plate-corner"
                data-corner="readout"
                data-readout
                data-locked-label={t("rubik.locked")}
                data-jammed-label={t("rubik.jammed")}
            >
                {t("rubik.locked")} · 0.00 N·m
            </output>
        </div>
            <div
      class="iso-stage rubik-stage"
      data-rubik-stage
      data-state="locked"
      tabindex="0"
      role="button"
      aria-label={t('rubik.aria')}
    >
      <RubikBaseLayer />
      <RubikLowerLayer />
      <RubikTopLayer />
      <RubikDialLayer />
    </div>
    </div>
</figure>

<script>
    import { initRubikCube } from "@/scripts/rubikCube";
    initRubikCube();
</script>

<style is:global>
    .rubik-figure.iso {
        --anatomy-card: var(--colors-surface);
        --anatomy-text: var(--colors-on-surface);
        --anatomy-strong: var(--colors-on-background);
        --anatomy-muted: var(--colors-on-surface-muted);
        --anatomy-paper: var(--colors-surface);
        --anatomy-face: light-dark(#ffffff, #1b1b1b);
        --anatomy-top: light-dark(#ffffff, #1c1c1c);
        --anatomy-shade-0: light-dark(#dcdcd9, #0f0f0f);
        --anatomy-shade-1: light-dark(#e5e5e2, #121212);
        --anatomy-shade-2: light-dark(#ededea, #151515);
        --anatomy-shade-3: light-dark(#f4f4f1, #181818);
        --anatomy-lit-top: light-dark(#ffffff, #262626);
        --anatomy-lit-shade: light-dark(#eeeeeb, #1d1d1d);
        --anatomy-hi: light-dark(#26262a, #d4d4d4);
        --anatomy-mid: light-dark(#76767b, #6a6a6a);
        --anatomy-lo: light-dark(#a4a4a8, #3e3e3e);
        --anatomy-faint: light-dark(#d0d0d4, #2a2a2a);
        --anatomy-lit: var(--colors-primary-light);
        --anatomy-halo: light-dark(#8a8a80, #050505);
        --anatomy-halo-opacity: light-dark(0.28, 0.85);
        --anatomy-dot: light-dark(#3a3a3e, #e6e6e6);
        --anatomy-weight: 0.6px;
        --anatomy-mono: var(--font-mono-console);
        margin: 0;
        width: 100%;
        counter-increment: figure-counter;
    }

    :root[data-theme="bee"] .rubik-figure.iso {
        --anatomy-face: #232015;
        --anatomy-top: #262216;
        --anatomy-shade-0: #100e09;
        --anatomy-shade-1: #15130c;
        --anatomy-shade-2: #1a1810;
        --anatomy-shade-3: #201d13;
        --anatomy-lit-top: #302b19;
        --anatomy-lit-shade: #252114;
        --anatomy-hi: #fef08a;
        --anatomy-mid: #a38436;
        --anatomy-lo: #635122;
        --anatomy-faint: #3d3316;
        --anatomy-lit: var(--colors-primary-light);
        --anatomy-halo: #060503;
        --anatomy-halo-opacity: 0.9;
        --anatomy-dot: #fef08a;
    }

    .rubik-figure .iso-plate {
        position: relative;
        padding: 40px 16px 40px;
        border-radius: 0;
        background: var(--anatomy-card);
        border: 1px solid var(--colors-outline-subtle);
        --anatomy-paper: var(--anatomy-card);
    }

    .rubik-figure .iso-plate-corners {
        position: absolute;
        inset: 14px 16px;
        pointer-events: none;
    }

    .rubik-figure .iso-plate-corner {
        position: absolute;
        color: var(--anatomy-muted);
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        line-height: 1.2;
        letter-spacing: 0.05em;
        white-space: nowrap;
    }

    .rubik-figure .iso-plate-corner[data-corner="fig"] {
        top: 0;
        left: 0;
        font-weight: var(--font-weight-semibold);
        color: var(--colors-primary-light);
    }

    .rubik-figure .iso-plate-corner[data-corner="fig"]::before {
        content: "Fig. " counter(figure-counter);
    }

    .rubik-figure .iso-plate-corner[data-corner="title"] {
        top: 0;
        right: 0;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .rubik-figure .iso-plate-corner[data-corner="hint"] {
        bottom: 0;
        left: 0;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .rubik-figure .iso-plate-corner[data-corner="readout"] {
        right: 0;
        bottom: 0;
        color: var(--anatomy-text);
        font-variant-numeric: tabular-nums;
    }

    .rubik-figure .rubik-stage {
        position: relative;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        -moz-user-select: none;
        user-select: none;
        touch-action: manipulation;
        outline: none;
    }

    .rubik-figure .rubik-stage:focus-visible {
        outline: 2px solid var(--colors-primary-light);
        outline-offset: 4px;
    }

    .rubik-figure .iso-svg {
        display: block;
        overflow: visible;
    }

    .rubik-figure .rubik-stage > .iso-svg {
        pointer-events: none;
    }

    .rubik-figure .rubik-stage > .iso-svg[data-layer="base"] {
        position: relative;
        width: 100%;
        height: auto;
        margin: 0 auto;
    }

    .rubik-figure .rubik-stage > .iso-svg:not([data-layer="base"]) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
    }

    .rubik-figure .iso-svg path,
    .rubik-figure .iso-svg circle {
        vector-effect: non-scaling-stroke;
    }

    .rubik-figure .iso-fill {
        fill: var(--anatomy-paper);
        stroke: none;
    }

    .rubik-figure .iso-solid[data-lit] > .iso-fill {
        fill: var(--anatomy-face);
    }

    .rubik-figure .iso-shade,
    .rubik-figure .iso-top {
        stroke: none;
    }

    .rubik-figure .iso-shade[data-shade="0"] {
        fill: var(--anatomy-shade-0);
    }

    .rubik-figure .iso-shade[data-shade="1"] {
        fill: var(--anatomy-shade-1);
    }

    .rubik-figure .iso-shade[data-shade="2"] {
        fill: var(--anatomy-shade-2);
    }

    .rubik-figure .iso-shade[data-shade="3"] {
        fill: var(--anatomy-shade-3);
    }

    .rubik-figure .iso-top {
        fill: var(--anatomy-top);
    }

    .rubik-figure .iso-solid[data-lit] > .iso-top {
        fill: var(--anatomy-lit-top);
    }

    .rubik-figure .iso-solid[data-lit] > .iso-shade {
        fill: var(--anatomy-lit-shade);
    }

    .rubik-figure .iso-solid[data-seamless] > .iso-shade,
    .rubik-figure .iso-solid[data-seamless] > .iso-top {
        stroke-width: 0.4;
        stroke-linejoin: round;
    }

    .rubik-figure .iso-solid[data-seamless] > .iso-shade[data-shade="0"] {
        stroke: var(--anatomy-shade-0);
    }

    .rubik-figure .iso-solid[data-seamless] > .iso-shade[data-shade="1"] {
        stroke: var(--anatomy-shade-1);
    }

    .rubik-figure .iso-solid[data-seamless] > .iso-shade[data-shade="2"] {
        stroke: var(--anatomy-shade-2);
    }

    .rubik-figure .iso-solid[data-seamless] > .iso-shade[data-shade="3"] {
        stroke: var(--anatomy-shade-3);
    }

    .rubik-figure .iso-solid[data-seamless] > .iso-top {
        stroke: var(--anatomy-top);
    }

    .rubik-figure .iso-solid[data-seamless][data-lit] > .iso-top {
        stroke: var(--anatomy-lit-top);
    }

    .rubik-figure .iso-solid[data-seamless][data-lit] > .iso-shade {
        stroke: var(--anatomy-lit-shade);
    }

    .rubik-figure .iso-solid[data-lit] > .iso-edge {
        stroke: var(--anatomy-lit);
    }

    .rubik-figure .iso-halo {
        fill: var(--anatomy-halo);
        stroke: none;
        filter: blur(9px);
        opacity: var(--anatomy-halo-opacity);
        transform: translateY(3px);
    }

    .rubik-figure .iso-line {
        fill: none;
        stroke: var(--anatomy-lo);
        stroke-width: var(--anatomy-weight);
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .rubik-figure .iso-line[data-tone="hi"] {
        stroke: var(--anatomy-hi);
    }

    .rubik-figure .iso-line[data-tone="mid"] {
        stroke: var(--anatomy-mid);
    }

    .rubik-figure .iso-line[data-tone="lo"] {
        stroke: var(--anatomy-lo);
    }

    .rubik-figure .iso-line[data-tone="faint"] {
        stroke: var(--anatomy-faint);
    }

    .rubik-figure .iso-line[data-tone="lit"] {
        stroke: var(--anatomy-lit);
    }

    .rubik-figure .iso-dots circle {
        fill: var(--anatomy-dot);
        stroke: none;
        opacity: 0.32;
    }

    .rubik-figure .iso-dots[data-tone="hi"] circle {
        opacity: 0.85;
    }

    .rubik-figure .iso-dots[data-tone="mid"] circle {
        opacity: 0.45;
    }

    .rubik-figure .iso-dots[data-tone="lo"] circle {
        opacity: 0.22;
    }

    .rubik-figure .iso-dots[data-tone="faint"] circle {
        opacity: 0.12;
    }

    .rubik-figure .iso-face-text {
        fill: var(--anatomy-mid);
        font-family: var(--anatomy-mono);
        letter-spacing: 0.04em;
    }

    .rubik-figure .iso-face-text[data-tone="hi"] {
        fill: var(--anatomy-hi);
    }

    .rubik-figure .iso-face-text[data-tone="lo"] {
        fill: var(--anatomy-lo);
    }

    .rubik-figure .iso-face-text[data-tone="faint"] {
        fill: var(--anatomy-faint);
    }

    @media (max-width: 560px) {
        .rubik-figure .iso-plate {
            padding: 40px 10px 58px;
        }

        .rubik-figure .iso-plate-corner[data-corner="hint"] {
            bottom: 20px;
        }
    }

    .rubik-figure .rubik-stage[data-animating] > [data-layer="lower"],
    .rubik-figure .rubik-stage[data-animating] > [data-layer="top"] {
        will-change: transform;
    }
</style>
