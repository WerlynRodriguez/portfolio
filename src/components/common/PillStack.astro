---
interface Props {
  primaryTech: string[];
  secondaryTech?: string[];
  ariaLabel: string;
  stackLabel?: string;
  layout?: 'flow' | 'masonry';
}

const {
  primaryTech,
  secondaryTech = [],
  ariaLabel,
  stackLabel = 'STACK',
  layout = 'flow',
} = Astro.props;
---

<footer class:list={['pill-stack-container', `layout-${layout}`]}>
  {stackLabel && <span class="stack-label" aria-hidden="true">{stackLabel}</span>}
  {layout === 'masonry' ? (
    <div class="stack-masonry" aria-label={ariaLabel}>
      {primaryTech.length > 0 && (
        <ul class="primary-stack" aria-label="Core stack">
          {primaryTech.map((tech) => (
            <li class="tech-pill primary-pill">{tech}</li>
          ))}
        </ul>
      )}
      {secondaryTech.length > 0 && (
        <ul class="secondary-stack" aria-label="Supporting stack">
          {secondaryTech.map((tech) => (
            <li class="tech-pill secondary-pill">[{tech}]</li>
          ))}
        </ul>
      )}
    </div>
  ) : (
    <ul class="stack-list" aria-label={ariaLabel}>
      {primaryTech.map((tech) => (
        <li class="tech-pill primary-pill">{tech}</li>
      ))}
      {secondaryTech.map((tech) => (
        <li class="tech-pill secondary-pill">[{tech}]</li>
      ))}
    </ul>
  )}
</footer>

<style>
  .pill-stack-container {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }

  .stack-label {
    font-family: var(--font-mono-console);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    color: var(--colors-on-surface-muted);
    letter-spacing: 0.08em;
  }

  .stack-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    font-family: var(--font-mono-console);
    font-size: var(--font-size-caption);
    border-radius: 0;
    line-height: 1.3;
    white-space: nowrap;
  }

  /* Primary pills: solid tokenized background and border */
  .primary-pill {
    background-color: var(--pill-main-bg);
    border: 1px solid var(--pill-main-border);
    color: var(--pill-main-color);
    font-weight: var(--font-weight-medium);
  }

  /* Secondary pills: dashed tokenized border and muted color */
  .secondary-pill {
    background-color: transparent;
    border: 1px dashed var(--pill-secondary-border);
    color: var(--pill-secondary-color);
  }

  /* ==========================================================================
     Pinterest Masonry Layout (Two-Tier)
     ========================================================================== */
  .pill-stack-container.layout-masonry {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    width: 100%;
    margin-top: auto;
  }

  .layout-masonry .stack-label {
    display: block;
    margin-bottom: 2px;
  }

  .layout-masonry .stack-masonry {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  /* Primary tier: prominent horizontal badges */
  .layout-masonry .primary-stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    width: 100%;
  }

  .layout-masonry .primary-stack .tech-pill {
    flex: 1 1 auto;
    justify-content: center;
    text-align: center;
    padding: 5px 10px;
    white-space: normal;
  }

  /* Secondary tier: Pinterest multi-column layout */
  .layout-masonry .secondary-stack {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    column-gap: 8px;
    width: 100%;
  }

  .layout-masonry .secondary-stack .tech-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    break-inside: avoid;
    margin-bottom: 8px;
    width: 100%;
    padding: 4px 8px;
    box-sizing: border-box;
    white-space: normal;
  }

  @media (max-width: 360px) {
    .layout-masonry .secondary-stack {
      columns: 1;
    }
  }
</style>
