---
import { type Locale, useTranslations } from '@i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="site-footer site-container">
    <div class="footer-row">
        <p class="footer-copyright">
            © <time datetime={String(currentYear)}>{currentYear}</time> Werlyn.
        </p>

        <p class="footer-attribution">{t("footer.aiAttribution")}</p>

        <div class="footer-action">
            <a
                href="#hero"
                class="btn-cad btn-secondary btn-to-top"
                aria-label={t("footer.backToTopAria")}
            >
                {t("footer.toTop")} ↑
            </a>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        padding-block: 28px 40px;
        border-top: 1px solid var(--colors-outline-subtle);
        font-family: var(--font-mono-console);
        font-size: var(--font-size-caption);
        color: var(--colors-on-surface-muted);
    }

    .footer-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 16px;
    }

    .footer-copyright {
        margin: 0;
        justify-self: start;
    }

    .footer-attribution {
        margin: 0;
        text-align: center;
        justify-self: center;
    }

    .footer-action {
        display: flex;
        align-items: center;
        justify-self: end;
    }

    .btn-to-top {
        min-height: 44px;
        padding: 8px 16px;
        font-size: var(--font-size-caption);
        text-decoration: none;
    }

    @media (max-width: 768px) {
        .footer-row {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 14px;
        }

        .footer-action {
            justify-self: center;
            order: 1;
        }

        .footer-attribution {
            order: 2;
        }

        .footer-copyright {
            justify-self: center;
            order: 3;
        }
    }
</style>
