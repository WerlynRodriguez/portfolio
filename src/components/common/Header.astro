---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Locale, useTranslations } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { href: '#overview', label: t('nav.overview') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#academics', label: t('nav.academics') },
  { href: '#contact', label: t('nav.contact') },
];
---

<header class="site-header site-container separator">
    <nav class="main-nav" aria-label={t("nav.aria")}>
        <ul>
            {navItems.map((item) => (
                <li>
                    <a href={item.href}>{item.label}</a>
                </li>
            ))}
        </ul>
    </nav>
    <nav class="lang-nav" aria-label={t("nav.langAria")}>
        <ul>
            <li>
                <a
                    href={getRelativeLocaleUrl("en", "")}
                    aria-current={lang === "en" ? "page" : undefined}
                    hreflang="en"
                    class:list={["lang-link", { active: lang === "en" }]}
                >
                    {t("lang.en")}
                </a>
            </li>
            <li>
                <a
                    href={getRelativeLocaleUrl("es", "")}
                    aria-current={lang === "es" ? "page" : undefined}
                    hreflang="es"
                    class:list={["lang-link", { active: lang === "es" }]}
                >
                    {t("lang.es")}
                </a>
            </li>
        </ul>
    </nav>
</header>

<style>
    .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        padding-block: 20px;
        font-family: var(--font-mono-console);
        font-size: var(--font-size-body-sm);
    }
    .main-nav ul,
    .lang-nav ul {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .main-nav a,
    .lang-nav a {
        color: var(--colors-on-surface-muted);
        text-decoration: none;
        transition: color var(--transition-micro);
    }
    .main-nav a:hover,
    .lang-nav a:hover {
        color: var(--colors-on-background);
    }
    .lang-link.active {
        color: var(--colors-primary-light);
        font-weight: var(--font-weight-semibold);
        border-bottom: 2px solid var(--colors-primary-light);
    }
</style>
